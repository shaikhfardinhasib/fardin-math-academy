# Real-project mode: copy to .env.local (or set in the host) and fill in. Placeholders only.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hsc-math-mcq-fardinshaikh.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hsc-math-mcq-fardinshaikh
NEXT_PUBLIC_FIREBASE_APP_ID=

# Domain used for synthetic student emails (<studentId>@<domain>). Must be a domain you
# control (no mail is ever sent). Leaving the placeholder blocks startup.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=students.example.invalid

# Admin credentials: exactly one of these.
# Local: path to the service account JSON, kept OUTSIDE the repo.
FIREBASE_ADMIN_CREDENTIALS_PATH=/home/kali/.secrets/firebase-admin.json
# Deployment: the same JSON, base64-encoded (base64 -w0 < key.json).
FIREBASE_ADMIN_CREDENTIALS_BASE64=

# Optional: comma-separated origins allowed to call /api/auth/* (default: the request's own host).
APP_ORIGINS=

# Must stay unset in real mode.
# FIREBASE_AUTH_EMULATOR_HOST=
# FIRESTORE_EMULATOR_HOST=
