# Emulator mode: copy to .env.local, then `npm run emulators` and `npm run dev`.
# Project ID demo-fma: the demo- prefix means the SDKs never reach real Google Cloud.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-fma.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fma
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Reserved .invalid TLD; the server refuses to start with it when emulators are off.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=students.example.invalid

# Admin SDK: with these set it initialises without credentials.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
