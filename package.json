{
  "name": "fardin-math-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "emulators": "firebase emulators:start --project demo-fma --only auth,firestore",
    "provision": "tsx --env-file-if-exists=.env.local scripts/provision-students.ts",
    "set-teacher": "tsx --env-file-if-exists=.env.local scripts/set-teacher.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
